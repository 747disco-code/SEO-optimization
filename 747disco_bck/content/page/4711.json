:"10","left":"10","isLinked":true},"margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"eae_slider_delay":"5000","gradient_color_list":[{"eae_animated_gradient_color":"#00a6d8","_id":"d7da2b7"},{"eae_animated_gradient_color":"#b800c9","_id":"b7a32fb"},{"eae_animated_gradient_color":"#e57600","_id":"6be5941"}]},"elements":[{"id":"4219009c","settings":{"title":"Perch\u00e8 vogliamo aiutarti?","title_color":"#917F59","typography_typography":"custom","typography_font_weight":"600"},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"2a302ef1","settings":{"editor":"<p>La nostri consigli si basa sulla La nostra lunga esperienza nel settore degli eventi ci ha insegnato quanto siano importanti i dettagli e come ogni elemento contribuisca a creare un\u2019esperienza unica. Per questo motivo, siamo motivati a condividere i nostri consigli e suggerimenti con te, anche se non scegli il nostro locale per il tuo evento.<\/p><p>La passione che mettiamo nel nostro lavoro va oltre il semplice fornire una location: vogliamo che ogni evento sia perfetto. Sappiamo quanto possa essere stressante organizzare una festa e quanto sia cruciale prendere le decisioni giuste. Ecco perch\u00e9 offriamo il nostro supporto senza impegno, perch\u00e9 per noi la vera soddisfazione \u00e8 vedere la gioia nei tuoi occhi e nei tuoi ospiti.<\/p><p>Il nostro background storico ci ha permesso di accumulare conoscenze preziose, che ora vogliamo condividere con te. Non importa dove deciderai di festeggiare: siamo qui per aiutarti a rendere il tuo evento indimenticabile, con consigli pratici e supporto professionale. Vogliamo che tu possa goderti la festa senza stress, sapendo che ogni dettaglio \u00e8 stato curato con attenzione.<\/p>","align":"justify","text_color":"#FFFFFF","typography_typography":"custom","typography_font_size":{"unit":"px","size":16,"sizes":[]},"typography_font_weight":"400","_element_custom_width":{"unit":"px","size":63