typography_font_weight":"500"},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"5aef0b1c","settings":{"editor":"<h2 style=\"font-size: 130%; color: #745c39;\">Contattaci per Prenotare la Tua Festa Esclusiva<\/h2>\n\n<p>Se stai cercando il <strong>locale perfetto per feste private a Roma<\/strong>, sei nel posto giusto! Il <strong>747 Disco<\/strong> \u00e8 la location ideale per <strong>diciottesimi, feste di compleanno, eventi aziendali, feste di laurea e celebrazioni esclusive<\/strong>. Offriamo un\u2019esperienza unica con <strong>pacchetti All-Inclusive<\/strong> che comprendono tutto: <strong>affitto del locale, DJ set, open bar, catering e servizio fotografico in omaggio<\/strong>.<\/p>\n\n<h3 style=\"font-size: 120%; color: #745c39;\">Perch\u00e9 scegliere 747 Disco?<\/h3>\n\n<ul>\n  <li>\ud83d\udccd <strong>Location esclusiva<\/strong> con ambientazione personalizzabile.<\/li>\n  <li>\ud83c\udfb6 <strong>Musica live e DJ set professionale<\/strong> per una serata indimenticabile.<\/li>\n  <li>\ud83c\udf7e <strong>Open bar e catering su misura<\/strong> con men\u00f9 personalizzati.<\/li>\n  <li>\ud83d\udcf8 <strong>Servizio fotografico gratuito<\/strong> per immortalare ogni momento.<\/li>\n  <li>\ud83d\udca1 <strong>Illuminazione e impianto audio top di gamma<\/strong> per un'atmosfera unica.<\/li>\n<\/ul>\n\n<p>\ud83d\udcde **Chiamaci subito al** <strong>3471811119<\/strong> per ricevere un preventivo personalizzato!  \n\ud83d\udce7 **Oppure scrivici a:** <a href=\"mailto:info@747disco.it\">info@747disco.it<\/a><\/p>\n\n<p>\ud83c\udf0d **Vuoi saperne di pi\u00f9?** Vieni a trovarci in **Viale J.F. Kennedy, 131 - Ciampino (RM)** e scopri come possiamo rendere il tuo evento un\u2019esperienza straordinaria!<\/p>\n\n<p>Non perdere l\u2019occasione di prenotare la tua data, gli eventi esclusivi vanno a ruba! \ud83d\ude80<\/p>\n\n<p>\ud83d\udccd <a href=\"https:\/\/747disco.it\/party-all-inclusive\/\" target=\"_blank\">Scopri i pacchetti All-Inclusive<\/a> | \ud83c\udf8a <a href=\"https:\/\/747disco.it\/feste-18-anni-location-per-eventi-roma\/\" target=\"_blank\">Festa 18 anni Roma<\/a> | \ud83c\udfc6 <a href=\"https:\/\/747disco.it\/festa-50-anni\/\" target=\"_blank\">Festa 50 anni<\/a><\/p>\n","align_mobile":"justify","text_color":"#DDCACA","typography_typography":"custom","typography_font_size":{"unit":"px","size":16,"sizes":[]},"typography_font_weight":"400","_margin_mobile":{"unit":"px","top":"10","right":"0","bottom":"0","left":"0","isLinked":false},"typography_font_size_mobile":{"unit":"px","size":14,"sizes":[]}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":false,"elType":"column"},{"id":"74bb12a","settings":{"_column_size":50,"_inline_size":39.944,"_inline_size_tablet":50,"eae_slider_delay":"5000","gradient_color_list":[{"eae_animated_gradient_color":"#00a6d8","_id":"2f1e879"},{"eae_animated_gradient_color":"#b800c9","_id":"6865afa"},{"eae_animated_gradient_color":"#e57600","_id":"927445a"}]},"elements":[{"id":"91af6bd","settings":{"form_name":"Nuovo modulo","form_fields":[{"custom_id":"name","field_label":"IL TUO NOME","dynamic":{"active":true},"_id":"5f52138"},{"custom_id":"email","field_type":"email","required":"true","field_label":"LA TUA EMAIL ","_id":"0e7c554"},{"_id":"986e184","field_type":"tel","field_label":"TELEFONO","custom_id":"field_986e184"},{"custom_id":"message","field_type":"textarea","field_label":"LASCIA IL TUO MESSAGGIO","_id":"ddc3e71"}],"step_next_label":"Successivo","step_previous_label":"Precedente","button_text":"Invia","email_content":"[all-fields]","form_metadata":["date","time","page_url","user_agent","remote_ip"],"email_content_2":"[all-fields]","success_message":"Your submission was successful.","error_message":"Your submission failed because of an error.","server_message":"Your submission failed because of a server error.","invalid_message":"Your submission failed because the form is invalid.","required_field_me